{
  "name": "job-agent-bot",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun --hot index.ts",
    "check": "bun run index.ts --check",
    "setup:whisper": "mkdir -p models && [ -f models/ggml-base.en.bin ] || curl -L -o models/ggml-base.en.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1",
    "grammy": "^1.46.0",
    "mammoth": "^1.13.0",
    "unpdf": "^2.2.1"
  }
}
