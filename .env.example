# Required
TELEGRAM_BOT_TOKEN=
OPENCODE_API_KEY=

# Inference
# OPENCODE_API_URL=https://opencode.ai/inference/go/openai/v1
# OPENCODE_MODEL=deepseek-v4.1-flash
# OPENCODE_STT_MODEL=whisper-1
# OPENCODE_TIMEOUT_MS=120000

# Voice transcription (local whisper.cpp base.en by default)
# STT_PROVIDER=whispercpp
# WHISPER_CPP_BIN=whisper-cli
# WHISPER_CPP_MODEL=./models/ggml-base.en.bin
# WHISPER_CPP_LANG=en
# WHISPER_CPP_THREADS=4
# FFMPEG_BIN=ffmpeg
# STT_TIMEOUT_MS=120000

# Optional API fallback for voice (STT_PROVIDER=api or auto)
# STT_API_URL=https://api.openai.com/v1/audio/transcriptions
# STT_API_KEY=
# STT_MODEL=whisper-1
# OPENAI_API_KEY=

# Who may use the bot (comma-separated Telegram user IDs). Empty = anyone.
ALLOWED_USER_IDS=

# Discovery
# TZ=Asia/Kolkata
# CRON_DISCOVERY=0 8 * * *
# FRESHNESS_DAYS=14
# DIGEST_TOP_N=8
# MIN_FIT=70
# MAX_PER_SOURCE=25
# CAREER_SCAN_LIMIT=3
# SOURCES=yc,hackernews,remotive,remoteok,github,techcrunch,producthunt,hnrss
# Extra RSS feeds (comma-separated URLs) appended to the news adapter
# WEB_SEARCH_RSS=
# GITHUB_TOKEN=

# Memory
# RAG_DIMENSIONS=512
# RAG_CHUNK_CHARS=900
# RAG_CHUNK_OVERLAP=120
# RECALL_K=5

# Email outreach (Resend). DRY_RUN defaults to true.
# DRY_RUN=true
# EMAIL_FROM=you@yourdomain.com
# EMAIL_REPLY_TO=you@yourdomain.com
# RESEND_API_KEY=

# Your identity used when drafting outreach
# USER_NAME=
# USER_EMAIL=
# USER_GITHUB=
# USER_LINKEDIN=
# USER_WEBSITE=

# Follow-up cadence in days (comma-separated)
# FOLLOW_UP_DAYS=4,10

# Storage
# DATA_DIR=./data

# Agent
# MAX_AGENT_STEPS=8
# MAX_RESPONSE_CHARS=4000
# LOG_LEVEL=info
